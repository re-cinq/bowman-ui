{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "rootDir": ".",
    "types": ["node", "vitest/globals", "@testing-library/jest-dom/vitest"]
  },
  "include": ["tests"],
  "exclude": [
    "dist",
    "node_modules",
    "examples",
    "tests/fixtures",
    "tests/types/*-type-assertions.*"
  ]
}
