{
  "name": "@re-cinq/bowman-ui",
  "version": "0.1.0",
  "description": "Presentational React components for AI chat interfaces. HAL Engine is the engine, Bowman is the face.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/re-cinq/bowman-ui#readme",
  "keywords": [
    "react",
    "chat",
    "ai",
    "ui",
    "components",
    "markdown",
    "tailwind",
    "accessibility"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/re-cinq/bowman-ui.git"
  },
  "bugs": {
    "url": "https://github.com/re-cinq/bowman-ui/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "rm -rf dist && node node_modules/typescript7/bin/tsc -p tsconfig.json && cp src/styles.css dist/styles.css",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit -p tsconfig.json",
    "test": "npm run test:coverage",
    "test:coverage": "npm run build && vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "check:duplication": "jscpd",
    "check:markdown-safety": "node scripts/check-markdown-safety.mjs",
    "check:spec-links": "node scripts/check-spec-links.mjs",
    "check:spec-status": "node scripts/check-spec-status.mjs",
    "check:at-pass": "node scripts/check-at-pass.mjs",
    "consumer": "scripts/consumer-app.sh",
    "rsc": "scripts/rsc-fixture.sh",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check ."
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "8.0.3",
    "@re-cinq/eslint-plugin-re-lint": "^1.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "jscpd": "^5.1.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rolldown": "^1.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.68.0",
    "typescript7": "npm:typescript@~7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
